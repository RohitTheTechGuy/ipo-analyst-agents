# Copy to .env (gitignored) and fill in. Never commit real values.
#   cp .env.example .env
# run_daily.py loads .env from the repo root, so it works from any directory and under launchd.

# --- Required ------------------------------------------------------------------
# OpenAI: all RHP reading (GPT-5.6 Luna) and the decision steps (GPT-5.6 Terra).
# Create at https://platform.openai.com/api-keys and set a monthly spend limit there as a backstop
# to the app's own $5.00-per-IPO cap ($4 analysis + $1 advisor).
OPENAI_API_KEY=

# Telegram: the bot that sends the summary + PDF report and closing reminders.
# Bot token from @BotFather; chat id of the chat/channel the bot should post to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional (the run still completes without them) ----------------------------
# Groq: free tier for small calls. If unset, Groq-routed tasks fail over to Luna (small extra cost).
# https://console.groq.com/keys
GROQ_API_KEY=

# Tavily: web search for the market-sentiment section. If unset, sentiment is reported as unavailable.
# https://app.tavily.com
TAVILY_API_KEY=

# xAI (Grok): required while a routed model uses `provider: xai` (the summary judge does).
# https://console.x.ai -> API keys. OpenAI-compatible API at https://api.x.ai/v1
XAI_API_KEY=

# Not needed here: DYLD_FALLBACK_LIBRARY_PATH (for the PDF renderer) must be set before Python starts,
# so it can't come from .env. The CLI re-execs itself with it and the launchd plist sets it.
# Discovery, GMP/subscription and peer prices use public sites and need no keys.
